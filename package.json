{
  "name": "fc-market-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "gate:0a": "node --experimental-strip-types src/cli/gate-0a.ts data/evidence/source-viability.json",
    "gate:0a:require-ready": "node --experimental-strip-types src/cli/gate-0a.ts data/evidence/source-viability.json --require-ready",
    "evidence:datacenter-price": "node --experimental-strip-types src/cli/datacenter-price-evidence.ts",
    "collect:price": "node --experimental-strip-types src/cli/collect-datacenter-price.ts",
    "ingest:price": "node --experimental-strip-types src/cli/ingest-price-history.ts",
    "collect:metadata": "node --experimental-strip-types src/cli/collect-openapi-metadata.ts",
    "ingest:metadata-usage": "node --experimental-strip-types src/cli/ingest-metadata-usage.ts",
    "metadata:detail-template": "node --experimental-strip-types src/cli/metadata-detail-template.ts",
    "ingest:metadata-detail": "node --experimental-strip-types src/cli/ingest-metadata-detail.ts",
    "collect:ranker-stats": "node --experimental-strip-types src/cli/collect-ranker-stats.ts",
    "ingest:ranker-stats": "node --experimental-strip-types src/cli/ingest-ranker-stats.ts",
    "annotations:check": "node --experimental-strip-types src/cli/ingest-market-annotations.ts --check",
    "ingest:annotations": "node --experimental-strip-types src/cli/ingest-market-annotations.ts",
    "build:structure": "node --experimental-strip-types src/cli/build-market-structure.ts",
    "benchmark:universe": "node --experimental-strip-types src/cli/build-market-universe.ts",
    "benchmark:discovery": "node --experimental-strip-types src/cli/build-benchmark-discovery.ts",
    "benchmark:gate1a": "node --experimental-strip-types src/cli/gate-1a.ts --require-ready",
    "benchmark:collect-discovery": "node --experimental-strip-types src/cli/collect-benchmark-discovery.ts",
    "benchmark:ingest-discovery": "node --experimental-strip-types src/cli/ingest-benchmark-discovery.ts",
    "benchmark:discovery-status": "node --experimental-strip-types src/cli/benchmark-discovery-status.ts",
    "benchmark:discovery-next": "node --experimental-strip-types src/cli/prepare-next-benchmark-discovery.ts",
    "benchmark:panel": "node --experimental-strip-types src/cli/build-benchmark-panel.ts",
    "benchmark:metrics": "node --experimental-strip-types src/cli/run-benchmark-metrics.ts",
    "benchmark:uncertainty": "node --experimental-strip-types src/cli/run-benchmark-uncertainty.ts",
    "benchmark:convergence": "node --experimental-strip-types src/cli/run-benchmark-convergence.ts",
    "benchmark:signal-diagnostic": "node --experimental-strip-types src/cli/run-benchmark-signal-diagnostic.ts",
    "benchmark:signal-candidates": "node --experimental-strip-types src/cli/run-benchmark-signal-candidates.ts",
    "benchmark:panel-refinement": "node --experimental-strip-types src/cli/run-benchmark-panel-refinement.ts",
    "benchmark:publish": "node --experimental-strip-types src/cli/publish-benchmark.ts",
    "benchmark:acceptance": "node --experimental-strip-types src/cli/run-benchmark-acceptance.ts",
    "benchmark:acceptance:require-complete": "node --experimental-strip-types src/cli/run-benchmark-acceptance.ts --require-complete",
    "benchmark:verify": "npm run benchmark:publish && npm run benchmark:acceptance:require-complete",
    "prepare:analysis": "node --experimental-strip-types src/cli/prepare-analysis-run.ts",
    "run:metrics": "node --experimental-strip-types src/cli/run-market-metrics.ts",
    "run:replay": "node --experimental-strip-types src/cli/run-event-replay.ts",
    "run:shock": "node --experimental-strip-types src/cli/run-shock-detection.ts",
    "acceptance:run": "node --experimental-strip-types src/cli/run-poc-acceptance.ts",
    "acceptance:require-complete": "node --experimental-strip-types src/cli/run-poc-acceptance.ts --require-complete",
    "poc:verify": "npm run check && npm run acceptance:require-complete",
    "viewer": "node --experimental-strip-types src/cli/view-market.ts",
    "acceptance:resolve-targets": "node --experimental-strip-types src/cli/resolve-acceptance-targets.ts",
    "acceptance:collect-targets": "node --experimental-strip-types src/cli/collect-datacenter-price.ts --targets data/catalog/acceptance-targets.resolved.json",
    "acceptance:ingest-targets": "node --experimental-strip-types src/cli/ingest-acceptance-targets.ts",
    "acceptance:seed-targets": "node --experimental-strip-types src/cli/seed-acceptance-targets.ts",
    "catalog:check": "node --experimental-strip-types src/cli/seed-catalog.ts data/catalog/seed-catalog.json",
    "catalog:targets": "node --experimental-strip-types src/cli/seed-catalog.ts data/catalog/seed-catalog.json --targets",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm test && npm run catalog:check && npm run gate:0a:require-ready && npm run gate:0b:require-ready",
    "gate:0b": "node --experimental-strip-types src/cli/gate-0b.ts --catalog data/catalog/seed-catalog.json --raw-dir data/raw/datacenter-price",
    "gate:0b:require-ready": "node --experimental-strip-types src/cli/gate-0b.ts --catalog data/catalog/seed-catalog.json --raw-dir data/raw/datacenter-price --require-ready",
    "browser:install": "playwright install --with-deps chromium",
    "sync:market": "node --experimental-strip-types src/cli/sync-market.ts",
    "sync:watch": "node --experimental-strip-types src/cli/watch-market.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "1.63.0"
  }
}
